# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string. Get a free one from neon.tech (recommended,
# works great with Vercel), or Vercel Postgres, or Supabase. It looks like:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_b5nesFr1NaOX@ep-super-leaf-axg9445a-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Used to sign login session tokens — set this to a long random string you make up yourself
JWT_SECRET="nasirahmad2008"

# Flutterwave v4 (OAuth-based) — from your Flutterwave dashboard.
# We're using v4's Pay With Bank Transfer (PWBT) flow, not direct card charges,
# because v4's card encryption docs currently contradict themselves (3DES vs
# AES-256) and PWBT never touches raw card data at all — safer to build on.
FLW_CLIENT_ID="0bcff661-ac3c-48ef-b482-83fc6355df14"
FLW_CLIENT_SECRET="f31VkkFKQKvWEwbQ63tt8pD3slQd6ofg"
FLW_ENCRYPTION_KEY=""
FLW_WEBHOOK_HASH="QoN32ymZk0mzui6ZLN7yxYLPjhzQ+kBQlNnfwkCNRjc="

# Rate limiting (Upstash Redis) — optional for local dev, but required before
# real production traffic. Free tier at upstash.com/redis. Without these set,
# rate limiting silently no-ops (a warning prints in your server console) —
# your app still works, just unprotected against brute-force/spam.
UPSTASH_REDIS_REST_URL="https://polished-rhino-184817.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAtHxAAIgcDJjY2JjYTEwYTNjMTA0NGIxOGI1MmFlYTQ2MjQwMDI2MQ"
